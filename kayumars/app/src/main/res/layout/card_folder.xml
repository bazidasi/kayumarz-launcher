<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_folder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/folder_modal_card"
        android:layout_width="316dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_folder"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Centered Editable Inline Folder Title -->
        <EditText
            android:id="@+id/folder_title_input"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@null"
            android:gravity="center"
            android:hint="@string/folder_rename_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/label_primary"
            android:textColorHint="@color/label_secondary"
            android:textSize="@dimen/text_title2"
            android:textStyle="bold" />

        <!-- 3-Column Inner Folder Grid (up to 9 items per page) -->
        <GridView
            android:id="@+id/folder_apps_grid"
            android:layout_width="match_parent"
            android:layout_height="276dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:horizontalSpacing="@dimen/spacing_8"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="@dimen/spacing_8" />

        <!-- Folder Pagination Bar (> 9 apps) -->
        <LinearLayout
            android:id="@+id/folder_pager_bar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_folder_prev"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/system_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_folder_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_12"
                android:textColor="@color/label_secondary"
                android:textSize="@dimen/text_footnote" />

            <TextView
                android:id="@+id/btn_folder_next"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/system_blue"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
