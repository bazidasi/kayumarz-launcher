<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_spotlight"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_spotlight"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/spotlight_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_12">

        <!-- Top Drag Handle + Search Input + Cancel Row -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/spacing_12"
            android:background="@drawable/bg_dot_blue"
            android:alpha="0.35" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/ios_search_field_height"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_8">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_glyph_search"
                    android:tint="@color/label_secondary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/spotlight_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionGo"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/label_primary"
                    android:textColorHint="@color/label_secondary"
                    android:textSize="@dimen/text_callout" />

                <ImageView
                    android:id="@+id/btn_spotlight_clear"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:padding="13dp"
                    android:src="@drawable/ic_glyph_close"
                    android:tint="@color/label_secondary"
                    android:visibility="gone"
                    android:contentDescription="@string/clear_search" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_spotlight_cancel"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_4"
                android:text="@string/cancel"
                android:textColor="@color/system_blue"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty-Query Siri Suggestions (4x2 Grid backed by Rust Core.topApps) -->
        <LinearLayout
            android:id="@+id/spotlight_suggestions_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                android:text="@string/spotlight_suggestions"
                android:textColor="@color/label_secondary"
                android:textSize="@dimen/text_footnote"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/spotlight_suggestions_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotlight_card"
                android:horizontalSpacing="4dp"
                android:numColumns="4"
                android:padding="@dimen/spacing_8"
                android:stretchMode="columnWidth"
                android:verticalSpacing="6dp" />
        </LinearLayout>

        <!-- Active Query: Applications Grid when > 6 matches -->
        <LinearLayout
            android:id="@+id/spotlight_apps_grid_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                android:text="@string/spotlight_applications"
                android:textColor="@color/label_secondary"
                android:textSize="@dimen/text_footnote"
                android:textStyle="bold" />

            <GridView
                android:id="@+id/spotlight_apps_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spotlight_card"
                android:horizontalSpacing="4dp"
                android:numColumns="4"
                android:padding="@dimen/spacing_8"
                android:stretchMode="columnWidth"
                android:verticalSpacing="6dp" />
        </LinearLayout>

        <!-- Ranked Results List (Top Hit + Applications + System Settings) -->
        <ListView
            android:id="@+id/spotlight_results_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="none" />

        <!-- Empty Search State -->
        <LinearLayout
            android:id="@+id/spotlight_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_spotlight_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/label_secondary"
                android:textSize="@dimen/text_subhead" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
