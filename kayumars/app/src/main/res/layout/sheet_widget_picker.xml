<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_widget_picker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_dim_60"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/widget_picker_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_spotlight"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_picker_title"
                android:textColor="@color/label_primary"
                android:textSize="@dimen/text_title2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_picker_close"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_4"
                android:text="@string/close"
                android:textColor="@color/system_blue"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_12"
            android:text="@string/widget_picker_subtitle"
            android:textColor="@color/label_secondary"
            android:textSize="@dimen/text_footnote" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/widget_picker_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
