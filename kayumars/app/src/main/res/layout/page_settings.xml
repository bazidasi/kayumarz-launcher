<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/system_grouped_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- iOS Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16">

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textColor="@color/label_primary"
            android:textSize="@dimen/text_title1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_settings_done"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_12"
            android:paddingEnd="@dimen/spacing_4"
            android:text="@string/done"
            android:textColor="@color/system_blue"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_sections_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_32" />
    </ScrollView>
</LinearLayout>
