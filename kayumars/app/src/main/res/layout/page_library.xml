<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_16"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_12">

    <!-- Top Centered iOS App Library Search Bar -->
    <LinearLayout
        android:id="@+id/library_search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ios_search_field_height"
        android:background="@drawable/bg_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_glyph_search"
            android:tint="@color/label_secondary"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/library_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/app_library_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/label_primary"
            android:textColorHint="@color/label_secondary"
            android:textSize="@dimen/text_callout" />

        <ImageView
            android:id="@+id/library_search_clear"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:padding="13dp"
            android:src="@drawable/ic_glyph_close"
            android:tint="@color/label_secondary"
            android:visibility="gone"
            android:contentDescription="@string/clear_search" />
    </LinearLayout>

    <!-- 2-Column Category Tiles Scroll Container -->
    <ScrollView
        android:id="@+id/library_categories_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_weight="1"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/library_categories_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="false" />
    </ScrollView>

    <!-- Expanded Category View / Filtered App Library List (shown on category tap or search) -->
    <LinearLayout
        android:id="@+id/library_expanded_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/library_expanded_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/home_label_fg"
                android:shadowColor="@color/home_label_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textSize="@dimen/text_title2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_library_back"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="@dimen/touch_target_min"
                android:background="@drawable/bg_done_pill"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_12"
                android:text="@string/close"
                android:textColor="@color/system_blue"
                android:textSize="@dimen/text_subhead"
                android:textStyle="bold" />
        </LinearLayout>

        <GridView
            android:id="@+id/library_expanded_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:layout_weight="1"
            android:horizontalSpacing="@dimen/spacing_8"
            android:numColumns="4"
            android:stretchMode="columnWidth"
            android:verticalSpacing="@dimen/spacing_12" />
    </LinearLayout>
</LinearLayout>
