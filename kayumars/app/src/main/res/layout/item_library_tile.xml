<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 16dp Rounded Thin-Blur Category Tile (3 large icons + 2x2 mini-cluster) -->
    <GridLayout
        android:id="@+id/lib_tile_card"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:background="@drawable/bg_library_tile"
        android:columnCount="2"
        android:padding="14dp"
        android:rowCount="2"
        android:useDefaultMargins="false">

        <ImageView
            android:id="@+id/lib_icon_0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/lib_icon_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/lib_icon_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Bottom-End Mini 2x2 Cluster (tapping cluster or tile opens full category) -->
        <GridLayout
            android:id="@+id/lib_mini_cluster"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="5dp"
            android:columnCount="2"
            android:rowCount="2">

            <ImageView
                android:id="@+id/lib_mini_0"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/lib_mini_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/lib_mini_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/lib_mini_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </GridLayout>
    </GridLayout>

    <!-- Category Title Centered Below Tile -->
    <TextView
        android:id="@+id/lib_tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/home_label_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/home_label_fg"
        android:textSize="@dimen/text_footnote"
        android:textStyle="bold" />
</LinearLayout>
