<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/folder_material_bg" />
            <corners android:radius="28dp" />
            <stroke android:width="0.5dp" android:color="@color/dock_material_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_sheen" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
