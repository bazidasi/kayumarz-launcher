<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted material: tint + top sheen. Real backdrop blur is applied by BackdropBlur on API 31+. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dock_material_bg" />
            <corners android:radius="@dimen/ios_radius_dock" />
            <stroke android:width="0.5dp" android:color="@color/dock_material_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_sheen" />
            <corners android:radius="@dimen/ios_radius_dock" />
        </shape>
    </item>
</layer-list>
