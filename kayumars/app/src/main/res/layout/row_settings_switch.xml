<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settings_switch_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ios_settings_row_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settings_switch_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/label_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/settings_switch_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/label_secondary"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/settings_switch_toggle"
            android:layout_width="46dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/spacing_8"
            android:splitTrack="false"
            android:thumb="@drawable/bg_ios_switch_thumb"
            android:track="@drawable/bg_ios_switch_track" />
    </LinearLayout>

    <View
        android:id="@+id/settings_switch_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ios_hairline"
        android:layout_marginStart="@dimen/spacing_16"
        android:background="@color/separator" />
</LinearLayout>
